# Copy to .env and fill in. Only ORS_API_KEY is required.
ORS_API_KEY=
# Optional overrides
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# How long a computed plan is reused before the routing quota is spent again
PLAN_CACHE_SECONDS=900
WEATHER_CACHE_SECONDS=1800
